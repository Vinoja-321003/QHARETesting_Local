<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(QualiFrameTfms)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssetTargetFallback>$(AssetTargetFallback);net8.0-windows;net8.0-windows7.0;net9.0-windows;net9.0-windows7.0;net10.0-windows;net10.0-windows7.0</AssetTargetFallback>
  </PropertyGroup>

  <ItemGroup>
    <!-- NUnit Testing Framework -->
    <PackageReference Include="BoDi" Version="1.5.0" />
    <PackageReference Include="NUnit" Version="4.6.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.13.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="143.0.7499.14600" />
    <ProjectReference Include="..\..\..\..\Qualiframe-Adaptive-Healing-Reliability-Engine-QHARE\adapters\selenium-csharp\src\Qhare.Selenium.NUnit\Qhare.Selenium.NUnit.csproj" />

    <!-- Reqnroll for BDD (Reqnroll is the maintained fork of SpecFlow) -->
    <PackageReference Include="Reqnroll" Version="3.3.4" />
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />
    <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" Version="3.3.4" />

    <!-- Selenium WebDriver -->
    <PackageReference Include="Selenium.WebDriver" Version="4.43.0" />
    <PackageReference Include="Selenium.Support" Version="4.43.0" />
    <PackageReference Include="Selenium.WebDriver.GeckoDriver" Version="0.36.0" />
    <PackageReference Include="Selenium.WebDriver.MSEdgeDriver" Version="141.0.3537.71" />
    <PackageReference Include="SeleniumExtras.WaitHelpers" Version="1.0.2" />

    <!-- Appium for Mobile Testing -->
    <PackageReference Include="Appium.WebDriver" Version="8.2.0" />

            <!-- REST API Testing -->
            <PackageReference Include="RestSharp" Version="113.0.0" />
            <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Reporting -->
    <PackageReference Include="ExtentReports" Version="5.0.4" />
    <PackageReference Include="Allure.NUnit" Version="2.15.0" />

    <!-- Data Access -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />

    <!-- Configuration (TFM-aligned via Directory.Build.props) -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="$(QualiFrameMsExtConfigVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="$(QualiFrameMsExtConfigVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(QualiFrameMsExtConfigVersion)" />

    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(QualiFrameMsExtDiVersion)" />

    <!-- Utilities -->
    <PackageReference Include="FluentAssertions" Version="8.9.0" />
    <PackageReference Include="AutoFixture" Version="4.18.1" />
    <PackageReference Include="Bogus" Version="35.6.5" />

    <!-- Performance Testing -->
    <!-- NOTE: NBomber removed due to commercial licensing; integrate external tools (e.g., k6/JMeter) at pipeline level if needed -->

    <!-- Docker Support -->
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />

    <!-- gRPC Support -->
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.76.0" PrivateAssets="All" />

    <!-- WebSocket Support -->
    <PackageReference Include="System.Net.WebSockets.Client" Version="4.3.2" />

    <!-- GraphQL Support -->
    <PackageReference Include="GraphQL.Client" Version="6.1.0" />
    <PackageReference Include="GraphQL.Client.Serializer.Newtonsoft" Version="6.1.0" />

    <!-- Kafka Support -->
    <PackageReference Include="Confluent.Kafka" Version="2.14.0" />

    <!-- AWS SDK -->
    <PackageReference Include="AWSSDK.Core" Version="4.0.6.1" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.23" />
    <PackageReference Include="AWSSDK.DeviceFarm" Version="4.0.4.23" />

            <!-- Azure SDK -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.27.0" />

    <!-- Monitoring and Observability -->
    <PackageReference Include="OpenTelemetry" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />

    <!-- JWT Support -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />

            <!-- Image Processing -->
            <PackageReference Include="SkiaSharp" Version="3.119.2" />

    <!-- PDF Processing -->
    <!-- NOTE: iText7 removed due to AGPL/commercial licensing; PDF features can be added with a permissive library if needed -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="$(QualiFrameBclPackageVersion)" />

    <!-- XML Processing -->
    <PackageReference Include="System.Xml.XmlDocument" Version="4.3.0" />

    <!-- Compression -->
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />

    <!-- Cryptography -->
    <PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />
    
    <!-- Azure Key Vault for Secrets Management -->
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    
    <!-- Polly for Retry Policies -->
    <PackageReference Include="Polly" Version="8.6.6" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
    
    <!-- Phase 1: ML.NET for Smart Test Selection -->
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="Microsoft.ML.TimeSeries" Version="5.0.0" />
    
    <!-- HTTP Client for Healenium Integration -->
    <PackageReference Include="System.Net.Http.Json" Version="$(QualiFrameBclPackageVersion)" />
    
    <!-- Medium Priority Features -->
    <!-- Applitools Eyes.Selenium removed: commercial use requires separate license. Use SkiaSharp-based visual testing for unrestricted commercial use. -->
    
    <!-- Accessibility Testing -->
    <PackageReference Include="Selenium.Axe" Version="1.5.0" />
    
    <!-- OWASP ZAP API Client - Using HttpClient for REST API calls -->
    <!-- Note: OWASPZAPDotNetAPI package may not be available, using direct HTTP calls instead -->
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Framework project -->
    <ProjectReference Include="..\QualiFrame.Framework\QualiFrame.Framework.csproj" />
    <ProjectReference Include="..\..\..\..\Qualiframe-Adaptive-Healing-Reliability-Engine-QHARE\adapters\selenium-csharp\src\Qhare.Selenium\Qhare.Selenium.csproj" />
    <ProjectReference Include="..\QualiFrame.Pdf.Core.Engine\QualiFrame.Pdf.Core.Engine.csproj" />
    <ProjectReference Include="..\QualiFrame.Mocking\QualiFrame.Mocking.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Features\**\*.feature" />
    <None Update="Resources\categories.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Configuration\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="allureConfig.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="..\QualiFrame.Mocking\Contracts\**\*" Link="Contracts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>