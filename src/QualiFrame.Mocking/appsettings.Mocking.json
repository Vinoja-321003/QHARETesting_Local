{
  "Mocking": {
    "Enabled": true,
    "Mode": "Dynamic",
    "UseDocker": false,
    "Port": 9091,
    "BaseUrl": "http://localhost:9091",
    "SwaggerPath": "Contracts/swagger.json",
    "ValidateContracts": true,
    "GenerateFromOpenApi": true,
    "ResetMappingsBetweenTests": true,
    "LogIncomingRequests": true,
    "LogUnmatchedRequests": true,
    "OpenApi": {
      "SpecPath": "Contracts/swagger.json",
      "PreferExamples": true,
      "DefaultSuccessStatusCode": 200,
      "AllowedMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
    },
    "Docker": {
      "Image": "wiremock/wiremock:3.9.2",
      "ContainerName": "qualiframe-wiremock",
      "HostPort": 9091,
      "StartupTimeoutSeconds": 30,
      "HealthCheckIntervalSeconds": 2,
      "RemoveContainerOnStop": true
    }
  }
}
