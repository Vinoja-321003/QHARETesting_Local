<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(QualiFrameTfms)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <Version>3.1.1</Version>
    <Authors>QualiFrame Team</Authors>
    <Description>QualiFrame API Mocking and Service Virtualization - WireMock.Net, OpenAPI-driven mocks, contract validation, and hybrid API/UI testing for Selenium C#</Description>
    <RootNamespace>QualiFrame.Mocking</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WireMock.Net" Version="2.5.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.29" />
    <PackageReference Include="Microsoft.OpenApi.Readers" Version="1.6.29" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="$(QualiFrameMsExtConfigVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="$(QualiFrameMsExtConfigVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="$(QualiFrameMsExtConfigVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="$(QualiFrameMsExtConfigVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(QualiFrameMsExtDiVersion)" />
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="NUnit" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Contracts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Mocking.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
